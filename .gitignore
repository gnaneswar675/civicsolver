# CivicSolver monorepo: keep frontend/ and backend/ in this one repository.
# Only local dependencies, secrets, generated output, and host metadata are ignored.

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Production Builds
build/
dist/
frontend/build/
frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Deployment & Hosting metadata
.vercel/
.render/
frontend/.vercel/
backend/.render/
.serverless

# Uploads & Temp directories
uploads/
backend/uploads/*
!backend/uploads/.gitkeep
tmp/
temp/

# Testing & Coverage
coverage/
.nyc_output/

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
