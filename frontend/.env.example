# ==============================================================================
# CIVICSOLVER FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env for local development, or add in Vercel project settings.
# On Vercel: Project Settings -> Environment Variables.
# NOTE: In Create React App, variables MUST start with REACT_APP_
# ==============================================================================

# Backend API Base URL (Do not include trailing slash)
# Local: http://localhost:5000
# Production: https://<your-render-app-name>.onrender.com
REACT_APP_API_URL=https://your-render-backend.onrender.com
